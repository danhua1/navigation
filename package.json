{
  "name": "navigation-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.12.0",
    "pnpm": ">=9.15.9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @navigation/web --filter @navigation/api dev",
    "dev:web": "pnpm --filter @navigation/web dev",
    "dev:api": "pnpm --filter @navigation/api start:dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @navigation/web test && pnpm --filter @navigation/api test",
    "db:generate": "pnpm --filter @navigation/api prisma:generate",
    "db:migrate": "pnpm --filter @navigation/api prisma:migrate"
  }
}
